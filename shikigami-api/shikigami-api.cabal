cabal-version: 3.0
name: shikigami-api
version: 0.1.0.0
synopsis:
  Shikigami public HTTP contract (routes, DTOs, problem details)

build-type: Simple
extra-source-files:
  test/hurl/*.hurl
  test/hurl/README.md
  test/hurl/run.sh

common common
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall
    -Werror=missing-fields
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shikigami.Agent.Api
    Shikigami.AgentRun.Api
    Shikigami.Api
    Shikigami.Api.OpenApi
    Shikigami.Api.Problem
    Shikigami.Caller.Api
    Shikigami.Health.Api
    Shikigami.Objective.Api
    Shikigami.Objective.HttpEnvelope
    Shikigami.Objective.Tracker.Api

  build-depends:
    aeson >=2.2,
    aeson-pretty >=0.8,
    base >=4.21 && <5,
    bytestring,
    http-api-data,
    http-media >=0.8,
    lens >=5.2,
    openapi-hs >=5.0 && <5.1,
    relay-pagination,
    relay-pagination-hasql,
    relay-pagination-servant,
    servant >=0.20 && <0.21,
    servant-health >=0.1 && <0.2,
    servant-openapi-hs >=5.1 && <5.2,
    shikigami-core,
    sop-core,
    text >=2.1,
    time,

executable shikigami-openapi
  import: common
  main-is: Main.hs
  hs-source-dirs: app/openapi
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    bytestring,
    directory,
    filepath,
    shikigami-api,

test-suite shikigami-api-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Shikigami.Agent.ApiSpec
    Shikigami.AgentRun.ApiSpec
    Shikigami.Api.OpenApiSpec
    Shikigami.Objective.ApiSpec

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    base,
    bytestring,
    directory,
    lens,
    openapi-hs,
    relay-pagination,
    shikigami-api,
    shikigami-core,
    tasty,
    tasty-hunit,
    text,
    time,
