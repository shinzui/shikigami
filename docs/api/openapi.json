{
  "components": {
    "schemas": {
      "AgentRunAccepted": {
        "properties": {
          "acceptedAt": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "agentName": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "agentName",
          "idempotencyKey",
          "status",
          "acceptedAt"
        ],
        "type": "object"
      },
      "AgentRunRequest": {
        "properties": {
          "idempotencyKey": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "idempotencyKey",
          "payload"
        ],
        "type": "object"
      },
      "AgentRunStatus": {
        "properties": {
          "acceptedAt": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "agentName": {
            "type": "string"
          },
          "completedAt": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "failure": {
            "$ref": "#/components/schemas/RunFailureView"
          },
          "runId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "startedAt": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "status": {
            "enum": [
              "accepted",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "agentName",
          "status"
        ],
        "type": "object"
      },
      "AgentView": {
        "properties": {
          "behavior": {
            "type": "string"
          },
          "delegates": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "lifecycle": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "principalId": {
            "type": "string"
          },
          "runnable": {
            "type": "boolean"
          },
          "sinks": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "trigger": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "enabled",
          "trigger",
          "behavior",
          "sinks",
          "delegates",
          "lifecycle",
          "runnable"
        ],
        "type": "object"
      },
      "Connection_AgentView": {
        "properties": {
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge_AgentView"
            },
            "type": "array"
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "edges",
          "pageInfo"
        ],
        "type": "object"
      },
      "Connection_RunRequestView": {
        "properties": {
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge_RunRequestView"
            },
            "type": "array"
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "edges",
          "pageInfo"
        ],
        "type": "object"
      },
      "Cursor": {
        "description": "opaque pagination cursor",
        "format": "base64url",
        "type": "string"
      },
      "Edge_AgentView": {
        "properties": {
          "cursor": {
            "$ref": "#/components/schemas/Cursor"
          },
          "node": {
            "$ref": "#/components/schemas/AgentView"
          }
        },
        "required": [
          "node",
          "cursor"
        ],
        "type": "object"
      },
      "Edge_RunRequestView": {
        "properties": {
          "cursor": {
            "$ref": "#/components/schemas/Cursor"
          },
          "node": {
            "$ref": "#/components/schemas/RunRequestView"
          }
        },
        "required": [
          "node",
          "cursor"
        ],
        "type": "object"
      },
      "PageInfo": {
        "properties": {
          "endCursor": {
            "$ref": "#/components/schemas/Cursor"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          },
          "startCursor": {
            "$ref": "#/components/schemas/Cursor"
          }
        },
        "required": [
          "hasNextPage",
          "hasPreviousPage"
        ],
        "type": "object"
      },
      "ProbeStatus": {
        "properties": {
          "check": {
            "type": "string"
          },
          "failingSince": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "check"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "retryable"
        ],
        "type": "object"
      },
      "RunFailureView": {
        "properties": {
          "kind": {
            "enum": [
              "refused",
              "dead_lettered",
              "behavior_failed",
              "workflow_failed"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "reason"
        ],
        "type": "object"
      },
      "RunRequestView": {
        "properties": {
          "acceptedAt": {
            "$ref": "#/components/schemas/UTCTime"
          },
          "disposition": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "requestedBy": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "idempotencyKey",
          "acceptedAt",
          "requestedBy",
          "disposition"
        ],
        "type": "object"
      },
      "UTCTime": {
        "example": "2016-07-22T00:00:00Z",
        "format": "yyyy-mm-ddThh:MM:ssZ",
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The public HTTP API of the Shikigami declared-agent runtime.",
    "title": "Shikigami",
    "version": "0.1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agents": {
      "get": {
        "operationId": "getAgents",
        "parameters": [
          {
            "description": "Forward page size (0..200). Defaults to 50 when neither 'first' nor 'last' is given. Cannot be combined with 'last' or 'before'.",
            "in": "query",
            "name": "first",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor: return items after this position (forward pagination).",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "format": "base64url",
              "type": "string"
            }
          },
          {
            "description": "Backward page size (0..200). Cannot be combined with 'first' or 'after'.",
            "in": "query",
            "name": "last",
            "required": false,
            "schema": {
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor: return items before this position (backward pagination).",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "format": "base64url",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection_AgentView"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Connection_AgentView"
                }
              }
            },
            "description": "A page of declared agents"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid pagination cursor or size"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing or invalid bearer credential"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The lifecycle directory is unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/agents/{agentName}": {
      "get": {
        "operationId": "getAgentsByAgentName",
        "parameters": [
          {
            "in": "path",
            "name": "agentName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentView"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/AgentView"
                }
              }
            },
            "description": "The declared agent"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing or invalid bearer credential"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "`agentName` or No such agent"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "The lifecycle directory is unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/agents/{agentName}/runs": {
      "get": {
        "operationId": "getAgentsByAgentNameRuns",
        "parameters": [
          {
            "in": "path",
            "name": "agentName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Forward page size (0..200). Defaults to 50 when neither 'first' nor 'last' is given. Cannot be combined with 'last' or 'before'.",
            "in": "query",
            "name": "first",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor: return items after this position (forward pagination).",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "format": "base64url",
              "type": "string"
            }
          },
          {
            "description": "Backward page size (0..200). Cannot be combined with 'first' or 'after'.",
            "in": "query",
            "name": "last",
            "required": false,
            "schema": {
              "maximum": 200,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor: return items before this position (backward pagination).",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "format": "base64url",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection_RunRequestView"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Connection_RunRequestView"
                }
              }
            },
            "description": "A page of accepted run requests"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid pagination cursor or size"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing or invalid bearer credential"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "`agentName` or Agent not found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Store unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "postAgentsByAgentNameRuns",
        "parameters": [
          {
            "in": "path",
            "name": "agentName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json;charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunAccepted"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunAccepted"
                }
              }
            },
            "description": "Run already accepted",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunAccepted"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunAccepted"
                }
              }
            },
            "description": "Run accepted",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `body`"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing or invalid bearer credential"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "`agentName` or Agent not found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Agent not runnable\n\nIdempotency key conflict"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Payload too large"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Store or directory unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/agents/{agentName}/runs/{runId}": {
      "get": {
        "operationId": "getAgentsByAgentNameRunsByRunId",
        "parameters": [
          {
            "in": "path",
            "name": "agentName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "runId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunStatus"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunStatus"
                }
              }
            },
            "description": "The run lifecycle"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Missing or invalid bearer credential"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "`agentName` or `runId` or Agent not found\n\nRun not found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Store unavailable"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Probe passed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Probe failed"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Probe passed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              },
              "application/json;charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Probe failed"
          }
        }
      }
    }
  }
}
