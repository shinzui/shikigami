cabal-version: 3.0
name: shikigami-client
version: 0.1.0.0
synopsis: Typed client for the Shikigami HTTP API
build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall
    -Werror=missing-fields
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Shikigami.Client
    Shikigami.Client.Command
    Shikigami.Client.Config
    Shikigami.Client.Payload
    Shikigami.Client.Version

  other-modules: Paths_shikigami_client
  autogen-modules: Paths_shikigami_client
  build-depends:
    aeson,
    base >=4.21 && <5,
    bytestring,
    githash,
    http-client >=0.7,
    http-client-tls >=0.3,
    network-uri,
    optparse-applicative >=0.18,
    relay-pagination,
    relay-pagination-servant,
    servant >=0.20 && <0.21,
    servant-client >=0.20 && <0.21,
    servant-client-core >=0.20 && <0.21,
    servant-health >=0.1 && <0.2,
    settei ==0.2.0.0,
    settei-env ==0.2.0.0,
    settei-optparse-applicative ==0.2.0.0,
    settei-yaml ==0.2.0.0,
    shikigami-api,
    text >=2.1,

executable shikigami-client
  import: common
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    optparse-applicative >=0.18,
    shikigami-client,

test-suite shikigami-client-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules: Shikigami.Client.ConfigSpec
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    optparse-applicative,
    settei,
    settei-env,
    settei-optparse-applicative,
    shikigami-client,
    tasty,
    tasty-hunit,
    text,
