packages:
  shikigami-api
  shikigami-core
  shikigami-client
  shikigami-migrations
  shikigami-server
  shikigami-workers

-- keiro-dsl is the build-time specification toolchain, not a library this
-- service links against. Listing it here makes `cabal run keiro-dsl -- ...`
-- resolve to the pinned cohort version inside this project, so CI and every
-- developer run the same checker against domain/shikigami.keiro-workspace
-- without depending on PATH or on a separate keiro checkout.
extra-packages: keiro-dsl

-- The conformance runner keiro-dsl generates for the shikigami service. The
-- glob is named after the service rather than a node, so it stays stable as
-- workspace members and nodes are added and `cabal test
-- keiro-shikigami-conformance` never has to change. The package, its .cabal,
-- and its Main.hs are generated; only KeiroConformance.Expectations inside it
-- is hand-owned.
optional-packages: shikigami-core/src/keiro-dsl-conformance.workspace.*/*.cabal

with-compiler: ghc-9.12.4

-- The co-developed dependency cohort is selected from published Hackage
-- releases. docs/dependency-cohort.md holds the release matrix, the upstream
-- tag commit behind each release, and the compatibility evidence. Only
-- packages with no Hackage release — or forks we still carry — are pinned by
-- commit below.

constraints:
  -- durable execution, event model, and agent memory
    keiki                   ==0.9.0.0
  , keiki-codec-json        ==0.9.0.0
  , keiro                   ==0.13.0.0
  , keiro-core              ==0.13.0.0
  , keiro-dsl               ==0.13.0.0
  , keiro-migrations        ==0.13.0.0
  , kioku-api               ==0.4.1.0
  , kioku-core              ==0.4.1.0
  , kioku-migrations        ==0.4.1.0

  -- typed model programs and providers
  , shikumi                 ==0.3.0.2
  , baikai                  ==0.5.0.0
  , baikai-claude           ==0.5.0.0

  -- worker runtime, queues, and the event store
  , shibuya-core            ==0.9.0.0
  , shibuya-pgmq-adapter    ==0.14.0.0
  , shibuya-kiroku-adapter  ==0.5.1.1
  , pgmq-core               ==0.5.0.0
  , pgmq-hasql              ==0.5.0.0
  , pgmq-effectful          ==0.5.0.0
  , kiroku-store            ==0.8.0.0
  , kiroku-store-migrations ==0.4.0.0
  , pg-migrate              ==1.1.0.0

  -- process configuration (plan 37) and tracing (plan 28)
  , settei                  ==0.2.0.0
  , hs-opentelemetry-api    ==1.0.0.0
  , hs-opentelemetry-sdk    ==1.0.0.0

-- ── Dependencies with no Hackage release ───────────────────────────────────

-- handan — typed-program runtime used by the behavior runner. Bumped to the
-- commit that compiles against shikumi 0.3 / shikumi-trace 0.2.
source-repository-package
  type: git
  location: https://github.com/shinzui/handan.git
  tag: 8e98b0a955f908f70657c04f384b6286e4967422
  subdir: handan-core

-- kafka-effectful — activity.v1 stream consumer.
source-repository-package
  type: git
  location: https://github.com/shinzui/kafka-effectful.git
  tag: f34a43cd476f7234848def9c0f08c54a1b67028e

-- danwa — conversation substrate client behind the DanwaConversation sink.
source-repository-package
  type: git
  location: https://github.com/shinzui/danwa.git
  tag: 301bc1b381fb1baa253b9ba5fce5735e6d0a8ca9
  subdir: danwa-core danwa-api danwa-client

-- Schema evolution is pg-migrate throughout: every library in the stack
-- publishes a MigrationComponent, and this repository composes them. See
-- docs/dependency-cohort.md.

package blake3
  flags: -avx512 -avx2 -sse41 -sse2
  ghc-options: -optc-DBLAKE3_USE_NEON=0

package postgresql-libpq
  flags: +use-pkg-config

allow-newer:
  haxl:time
