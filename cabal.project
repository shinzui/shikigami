packages:
  shikigami-api
  shikigami-core
  shikigami-cli
  shikigami-migrations

with-compiler: ghc-9.12.4

-- Co-developed shinzui dependencies pinned by GitHub commit (no local-path /
-- corpus checkouts). dhall comes from Hackage (see build-depends bounds).

-- kioku — reusable event-sourced memory/session library. Pinned to the
-- delegation-lineage commit required by ExecPlan 9.
source-repository-package
  type: git
  location: https://github.com/shinzui/kioku.git
  tag: 8bcfc282484dd59b0a0b25530cca4f3ad9034ce1
  subdir: kioku-api kioku-core kioku-cli kioku-migrations

-- handan — typed-program runtime (used by EP-2's behavior runner).
source-repository-package
  type: git
  location: https://github.com/shinzui/handan.git
  tag: d25fac3f758d9f0143fc00f27437d4e477801321
  subdir: handan-core

-- shikumi — typed-program compiler; a kioku-core dependency. Tagged shikumi-0.1.0.1.
source-repository-package
  type: git
  location: https://github.com/shinzui/shikumi.git
  tag: 36496deef05060ef9e49486225ab475541343f05
  subdir: shikumi shikumi-trace

-- kafka-effectful — activity.v1 stream consumer (used by EP-4).
source-repository-package
  type: git
  location: https://github.com/shinzui/kafka-effectful.git
  tag: f34a43cd476f7234848def9c0f08c54a1b67028e

-- danwa — conversation substrate client used by ExecPlan 8's CLI spike and,
-- later, the real DanwaConversation sink. Pinned to current origin/master.
source-repository-package
  type: git
  location: https://github.com/shinzui/danwa.git
  tag: 301bc1b381fb1baa253b9ba5fce5735e6d0a8ca9
  subdir: danwa-core danwa-api danwa-client

-- ↓↓↓ The kikan pin block, copied byte-identically from
--    https://github.com/shinzui/kioku.git:cabal.project (its source-repository-package
--    stanzas + footer). This is the coherent kikan set kioku was built against,
--    including baikai (a kioku-core dependency) at kioku's pinned commit. See IP-8.

source-repository-package
