-- ── Dependencies with no Hackage release ───────────────────────────────────
-- handan — typed-program runtime used by the behavior runner. Bumped to the
-- commit that compiles against shikumi 0.3 / shikumi-trace 0.2.
source-repository-package
  type: git
  location: https://github.com/shinzui/handan.git
  tag: 8e98b0a955f908f70657c04f384b6286e4967422
  subdir: handan-core

-- danwa — conversation substrate client behind the DanwaConversation sink.
source-repository-package
  type: git
  location: https://github.com/shinzui/danwa.git
  tag: 301bc1b381fb1baa253b9ba5fce5735e6d0a8ca9
  subdir: danwa-core danwa-api danwa-client

-- en has no released package or source tag. kikan-en-client verifies decision
-- proofs against this exact generic engine revision.
-- mori://shinzui/en/repos/en
source-repository-package
  type: git
  location: https://github.com/shinzui/en.git
  tag: 51edaab17473f7b9310f8802ccffd23bac5e4a9e
  subdir: en-core en-biscuit

-- Shomei's 0.1.0.0 tags resolve to this commit and are not on Hackage. The
-- client package supplies the production OAuth2 client_credentials call.
-- mori://shinzui/shomei/repos/shomei
source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 65551cb120336b53695c0dd30ebe0e473d6efcb2
  subdir: shomei-core shomei-jwt shomei-servant shomei-client

-- en-biscuit's current proof parser dependency.
-- mori://shinzui/biscuit-haskell
source-repository-package
  type: git
  location: https://github.com/shinzui/biscuit-haskell.git
  tag: 8c0b3c5a13ce4a310737c0336f2ae167a1597588
  subdir: biscuit

-- blake3 (through shikumi-cache) is built with its portable C implementation.
package blake3
  flags: -avx512 -avx2 -sse41 -sse2
  ghc-options: -optc-DBLAKE3_USE_NEON=0

package postgresql-libpq
  flags: +use-pkg-config

-- The third-party claude package still caps http-client-tls below 0.4, which
-- the selected Crypton 1.1 / TLS 2.x cohort requires; its used API is
-- compatible. Remove after a Hackage revision or release widens the bound.
-- pg-migrate-test-support 1.1.0.0 still caps ephemeral-pg below 0.3, while
-- keiro-test-support 0.18 requires the compatible ephemeral-pg 0.3 API.
allow-newer:
  claude:http-client-tls,
  pg-migrate-test-support:ephemeral-pg
