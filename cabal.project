packages:
  -- The two ../kikan-project paths are the co-developed public action boundary
  -- from mori://shinzui/kikan-en. Replace them with the exact upstream commit
  -- once the M2-M4 commits are published; the packages themselves remain the
  -- only Kikan dependency.
  shikigami-agent
  shikigami-api
  shikigami-core
  shikigami-client
  shikigami-migrations
  shikigami-server
  shikigami-workers
  ../kikan-project/kikan-en/kikan-en-contract
  ../kikan-project/kikan-en/kikan-en-client

-- keiro-dsl is the build-time specification toolchain, not a library this
-- service links against. Listing it here makes `cabal run keiro-dsl -- ...`
-- resolve to the pinned cohort version inside this project, so CI and every
-- developer run the same checker against domain/shikigami.keiro-workspace
-- without depending on PATH or on a separate keiro checkout.
extra-packages: keiro-dsl
-- The conformance runner keiro-dsl generates for the shikigami service. The
-- glob is named after the service rather than a node, so it stays stable as
-- workspace members and nodes are added and `cabal test
-- keiro-shikigami-conformance` never has to change. The package, its .cabal,
-- and its Main.hs are generated; only KeiroConformance.Expectations inside it
-- is hand-owned.
optional-packages: shikigami-core/src/keiro-dsl-conformance.workspace.*/*.cabal
with-compiler: ghc-9.12.4
-- The co-developed cohort is selected by the components' own build-depends
-- bounds, resolved against this fixed Hackage snapshot. Advance it to move the
-- cohort; docs/dependency-cohort.md records the release matrix and evidence.
index-state: 2026-09-19T01:06:24Z
-- Nothing links keiro-dsl, so no bound ties it to the runtime's Keiro release;
-- the toolchain and the runtime move in lockstep.
constraints: keiro-dsl ==0.17.0.0

-- ── Dependencies with no Hackage release ───────────────────────────────────
-- handan — typed-program runtime used by the behavior runner. Bumped to the
-- commit that compiles against shikumi 0.3 / shikumi-trace 0.2.
source-repository-package
  type: git
  location: https://github.com/shinzui/handan.git
  tag: 8e98b0a955f908f70657c04f384b6286e4967422
  subdir: handan-core

-- danwa — conversation substrate client behind the DanwaConversation sink.
source-repository-package
  type: git
  location: https://github.com/shinzui/danwa.git
  tag: 301bc1b381fb1baa253b9ba5fce5735e6d0a8ca9
  subdir: danwa-core danwa-api danwa-client

-- en has no released package or source tag. kikan-en-client verifies decision
-- proofs against this exact generic engine revision.
-- mori://shinzui/en/repos/en
source-repository-package
  type: git
  location: https://github.com/shinzui/en.git
  tag: 51edaab17473f7b9310f8802ccffd23bac5e4a9e
  subdir: en-core en-biscuit

-- Shomei's 0.1.0.0 tags resolve to this commit and are not on Hackage. The
-- client package supplies the production OAuth2 client_credentials call.
-- mori://shinzui/shomei/repos/shomei
source-repository-package
  type: git
  location: https://github.com/shinzui/shomei.git
  tag: 65551cb120336b53695c0dd30ebe0e473d6efcb2
  subdir: shomei-core shomei-jwt shomei-servant shomei-client

-- en-biscuit's current proof parser dependency.
-- mori://shinzui/biscuit-haskell
source-repository-package
  type: git
  location: https://github.com/shinzui/biscuit-haskell.git
  tag: 8c0b3c5a13ce4a310737c0336f2ae167a1597588
  subdir: biscuit

-- blake3 (through shikumi-cache) is built with its portable C implementation.
package blake3
  flags: -avx512 -avx2 -sse41 -sse2
  ghc-options: -optc-DBLAKE3_USE_NEON=0

package postgresql-libpq
  flags: +use-pkg-config

-- The third-party claude package still caps http-client-tls below 0.4, which
-- the selected Crypton 1.1 / TLS 2.x cohort requires; its used API is
-- compatible. Remove after a Hackage revision or release widens the bound.
allow-newer: claude:http-client-tls
