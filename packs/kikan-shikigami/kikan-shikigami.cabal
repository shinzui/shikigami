cabal-version: 3.4
name: kikan-shikigami
version: 0.1.0.0
synopsis: The Kikan distribution of Shikigami: stock roles composed with flow packs
description:
  The stock Shikigami executables run kernel behaviors and declared agents.
  The organizational use cases ship as flow packs, and this distribution
  composes them into a worker, an admin command and a one-off agent command.
  It holds executables and no library. See docs/user/flows.md.

license: BSD-3-Clause
build-type: Simple

common common
  default-language: GHC2024
  hs-source-dirs: src-shared
  other-modules: Packs
  ghc-options:
    -Wall
    -Wcompat
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    flow-pack-examples,
    flow-pack-initiative,
    flow-pack-practice-review,
    flow-pack-watchdog,
    kikan-shikigami-binding,
    shikigami-core:flow-sdk,

executable kikan-shikigami-worker
  import: common
  hs-source-dirs: app/worker
  main-is: Main.hs
  build-depends: shikigami-workers

executable kikan-shikigami-workspace-supervisor
  import: common
  hs-source-dirs: app/workspace-supervisor
  main-is: Main.hs
  build-depends: shikigami-workers

executable kikan-shikigami-consume-stream
  import: common
  hs-source-dirs: app/consume-stream
  main-is: Main.hs
  build-depends: shikigami-workers

executable kikan-shikigami-scheduler
  import: common
  hs-source-dirs: app/scheduler
  main-is: Main.hs
  build-depends: shikigami-workers

executable kikan-shikigami
  import: common
  hs-source-dirs: app/admin
  main-is: Main.hs
  build-depends: shikigami-server

executable kikan-shikigami-agent-run
  import: common
  hs-source-dirs: app/agent-run
  main-is: Main.hs
  build-depends: shikigami-agent

-- What needs two composed use cases together. It shares no module with the
-- executables.
test-suite kikan-shikigami-test
  type: exitcode-stdio-1.0
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Kikan.Fixture.ExecutionIdentity
    Kikan.Fixture.Watchdog
    Kikan.Fixture.WatchdogExecution
    Kikan.WatchdogQualificationSpec
    Kikan.WatchdogSweepSpec
    Kikan.WatchdogTelemetrySpec

  ghc-options:
    -Wall
    -Wcompat
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    async,
    baikai,
    base,
    bytestring,
    containers,
    directory,
    effectful,
    effectful-core,
    filepath,
    flow-pack-initiative,
    flow-pack-initiative:test-support,
    flow-pack-watchdog,
    generic-lens,
    hasql,
    hasql-pool,
    hasql-transaction,
    hs-opentelemetry-api,
    hs-opentelemetry-exporter-in-memory,
    hs-opentelemetry-sdk,
    keiro,
    keiro-pgmq,
    kioku-api,
    kioku-core,
    kiroku-store,
    lens,
    pgmq-hasql,
    shibuya-core,
    shikigami-core,
    shikigami-migrations:test-support,
    shikigami-workers,
    shikumi-tools,
    tasty,
    tasty-hunit,
    text,
    time,
    unix,
    uuid,
    vector,
