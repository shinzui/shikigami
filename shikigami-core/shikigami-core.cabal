cabal-version: 3.0
name: shikigami-core
version: 0.1.0.0
synopsis: Shikigami runtime core (loader, scope helper)
build-type: Simple
extra-source-files: test/fixtures/durable-skill/SKILL.md

flag objective-tracker-rei-tests
  description: Run mandatory real-Rei qualification through the disposable launcher
  default: False
  manual: True

common common
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall
    -Werror=missing-fields
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

