cabal-version: 3.0
name:          shikigami-core
version:       0.1.0.0
synopsis:      Shikigami runtime core (loader, scope helper)
build-type:    Simple

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Shikigami.Agent.Loader
    Shikigami.Agent.Run
    Shikigami.Agent.Skill
    Shikigami.Agent.Workflow
    Shikigami.Behavior.Error
    Shikigami.Behavior.Run
    Shikigami.Behavior.Skill
    Shikigami.Behavior.StubProvider
    Shikigami.Core
    Shikigami.Memory.Scope
    Shikigami.Program.Registry
    Shikigami.Sink
    Shikigami.Sink.Config
    Shikigami.Sink.Danwa
    Shikigami.Sink.Http
    Shikigami.Sink.KawaClient
    Shikigami.Sink.KawaStub
    Shikigami.Sink.KawaStub.Republish
    Shikigami.Sink.KizashiClient
    Shikigami.Sink.Permission
    Shikigami.Sink.ReiAction
    Shikigami.Sink.Types
    Shikigami.Sink.Wire
    Shikigami.Trigger.Consumer
    Shikigami.Trigger.Enqueue
    Shikigami.Trigger.Publish
    Shikigami.Trigger.Schedule
    Shikigami.Trigger.Stream
    Shikigami.Worker

  build-depends:
    , aeson                 >=2.2
    , async
    , baikai
    , base                  >=4.21 && <5
    , bytestring
    , containers            >=0.6
    , cron
    , dhall                 >=1.42
    , directory             >=1.3
    , effectful
    , filepath              >=1.4
    , handan-core
    , hasql-pool
    , hasql-transaction
    , http-client
    , http-types
    , hw-kafka-client
    , kafka-effectful
    , keiro
    , keiro-core
    , kioku-api
    , kioku-core
    , kiroku-store
    , mmzk-typeid
    , pgmq-effectful
    , pgmq-hasql
    , shibuya-core
    , shibuya-pgmq-adapter
    , shikigami-api
    , shikumi
    , text                  >=2.1
    , time                  >=1.12
    , uuid
    , vector                >=0.13
    , wai
    , warp
    , yaml                  >=0.11

test-suite shikigami-core-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  other-modules:
    Shikigami.AgentWorkflowSpec
    Shikigami.SpikeWorkflowSpec

  hs-source-dirs: test
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , effectful
    , http-types
    , keiro
    , kioku-core
    , kiroku-store
    , shikigami-api
    , shikigami-core
    , shikigami-migrations:test-support
    , tasty
    , tasty-hunit
    , text
    , time
    , wai
    , warp
