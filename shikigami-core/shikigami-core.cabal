cabal-version: 3.0
name:          shikigami-core
version:       0.1.0.0
synopsis:      Shikigami runtime core (loader, scope helper)
build-type:    Simple

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Shikigami.Activity
    Shikigami.Agent.Approval
    Shikigami.Agent.Conversation
    Shikigami.Agent.Decl
    Shikigami.Agent.Delegate
    Shikigami.Agent.Delegate.Context
    Shikigami.Agent.Loader
    Shikigami.Agent.Run
    Shikigami.Agent.RunJob
    Shikigami.Agent.Skill
    Shikigami.Agent.Workflow
    Shikigami.Agent.Workflow.Input
    Shikigami.Agent.Workflow.Name
    Shikigami.App.Config
    Shikigami.Behavior.Error
    Shikigami.Behavior.Run
    Shikigami.Behavior.Skill
    Shikigami.Behavior.StubProvider
    Shikigami.Core
    Shikigami.Flow
    Shikigami.Flow.Acknowledgement
    Shikigami.Flow.AtRiskCustomer
    Shikigami.Flow.Capability
    Shikigami.Flow.Lifecycle.AtRiskCustomer
    Shikigami.Flow.SinkOutbox
    Shikigami.Integration.Danwa
    Shikigami.Memory.Scope
    Shikigami.Prelude
    Shikigami.Program.Registry
    Shikigami.Sink
    Shikigami.Sink.Config
    Shikigami.Sink.Danwa
    Shikigami.Sink.Http
    Shikigami.Sink.KawaClient
    Shikigami.Sink.KizashiClient
    Shikigami.Sink.Permission
    Shikigami.Sink.ReiAction
    Shikigami.Sink.Types
    Shikigami.Sink.Wire
    Shikigami.Telemetry
    Shikigami.Trigger.Consumer
    Shikigami.Trigger.Enqueue
    Shikigami.Trigger.Schedule
    Shikigami.Trigger.Scheduler
    Shikigami.Trigger.Stream
    Shikigami.Worker

  build-depends:
    , aeson                           >=2.2
    , async
    , baikai
    , baikai-trace-otel
    , base                            >=4.21 && <5
    , bytestring
    , containers                      >=0.6
    , cron
    , danwa-api
    , danwa-client
    , dhall                           >=1.42
    , directory                       >=1.3
    , effectful
    , filepath                        >=1.4
    , generic-lens                    >=2.2
    , handan-core
    , hasql
    , hasql-pool
    , hasql-transaction
    , hs-opentelemetry-api
    , hs-opentelemetry-exporter-otlp
    , hs-opentelemetry-sdk
    , http-client
    , http-types
    , hw-kafka-client
    , kafka-effectful
    , keiki
    , keiro
    , keiro-core
    , kioku-api
    , kioku-core
    , kiroku-store
    , lens                            >=5.2
    , mmzk-typeid
    , pgmq-effectful
    , pgmq-hasql
    , shibuya-core
    , shibuya-pgmq-adapter
    , shikumi
    , text                            >=2.1
    , time                            >=1.12
    , uuid
    , vector                          >=0.13
    , yaml                            >=0.11

test-suite shikigami-core-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  other-modules:
    Shikigami.AgentWorkflowSpec
    Shikigami.DelegateContextSpec
    Shikigami.Fixture.KawaStub
    Shikigami.FlowLifecycleSpec
    Shikigami.SchedulerSpec
    Shikigami.SpikeWorkflowSpec

  hs-source-dirs: test
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , effectful
    , hasql
    , hasql-pool
    , http-types
    , keiki
    , keiro
    , kioku-api
    , kioku-core
    , kiroku-store
    , pgmq-hasql
    , shikigami-core
    , shikigami-migrations:test-support
    , tasty
    , tasty-hunit
    , text
    , time
    , vector
    , wai
    , warp
