cabal-version: 3.0
name:          shikigami-core
version:       0.1.0.0
synopsis:      Shikigami runtime core (loader, scope helper)
build-type:    Simple

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Shikigami.Activity
    Shikigami.Agent.Approval
    Shikigami.Agent.Conversation
    Shikigami.Agent.Decl
    Shikigami.Agent.Delegate
    Shikigami.Agent.Delegate.Context
    Shikigami.Agent.Loader
    Shikigami.Agent.Run
    Shikigami.Agent.RunJob
    Shikigami.Agent.Skill
    Shikigami.Agent.Workflow
    Shikigami.Agent.Workflow.Input
    Shikigami.Agent.Workflow.Name
    Shikigami.App.Config
    Shikigami.App.Config.Load
    Shikigami.Behavior.Error
    Shikigami.Behavior.Input
    Shikigami.Behavior.Provider
    Shikigami.Behavior.Run
    Shikigami.Behavior.Skill
    Shikigami.Behavior.StubProvider
    Shikigami.Core
    Shikigami.Flow
    Shikigami.Flow.Acknowledgement
    Shikigami.Flow.AtRiskCustomer
    Shikigami.Flow.Capability
    Shikigami.Flow.Lifecycle.AtRiskCustomer
    Shikigami.Flow.SinkOutbox
    Shikigami.Generated.Conformance
    Shikigami.Integration.Danwa
    Shikigami.Log
    Shikigami.Log.Correlation
    Shikigami.Memory.Access
    Shikigami.Memory.Scope
    Shikigami.Prelude
    Shikigami.Program.Registry
    Shikigami.Sink
    Shikigami.Sink.Config
    Shikigami.Sink.Danwa
    Shikigami.Sink.GrantStore
    Shikigami.Sink.Http
    Shikigami.Sink.KawaClient
    Shikigami.Sink.KizashiClient
    Shikigami.Sink.Permission
    Shikigami.Sink.Recipient
    Shikigami.Sink.ReiAction
    Shikigami.Sink.Types
    Shikigami.Sink.Validate
    Shikigami.Sink.Wire
    Shikigami.Trigger.Enqueue
    Shikigami.Trigger.Schedule
    Shikigami.Trigger.Stream

  -- Generated by `keiro-dsl scaffold domain/shikigami.keiro-workspace`. This
  -- block and the `Shikigami.Generated.Conformance` line above are pasted from
  -- src/keiro-dsl-cabal-fragment.workspace.shikigami.txt, which is the
  -- authoritative build inventory for the generated layer. Never edit a
  -- generated module; change domain/*.keiro and scaffold again.
  other-modules:
    Shikigami.AgentRun.Generated.WorkflowFacts
    Shikigami.AgentRun.Generated.WorkflowRuntime
    Shikigami.DanwaConversation.Generated.WorkflowFacts
    Shikigami.DanwaConversation.Generated.WorkflowRuntime

  build-depends:
    , aeson                        >=2.2
    , baikai
    , baikai-claude
    , base                         >=4.21    && <5
    , bytestring
    , containers                   >=0.6
    , cron
    , danwa-api
    , danwa-client
    , dhall                        >=1.42
    , directory                    >=1.3
    , effectful
    , effectful-core
    , filepath                     >=1.4
    , generic-lens                 >=2.2
    , handan-core
    , hasql
    , hasql-pool
    , hasql-transaction
    , hs-opentelemetry-api
    , http-client
    , http-types
    , keiki
    , keiro
    , keiro-core
    , kioku-api
    , kioku-core
    , kiroku-store
    , lens                         >=5.2
    , mmzk-typeid
    , optparse-applicative         >=0.19    && <0.20
    , pgmq-hasql
    , settei                       ==0.2.0.0
    , settei-env                   ==0.2.0.0
    , settei-optparse-applicative  ==0.2.0.0
    , settei-yaml                  ==0.2.0.0
    , shibuya-core
    , shikumi
    , text                         >=2.1
    , time                         >=1.12
    , uuid
    , vector                       >=0.13
    , yaml                         >=0.11

test-suite shikigami-core-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  other-modules:
    Shikigami.AgentWorkflowSpec
    Shikigami.AppConfigSpec
    Shikigami.BehaviorInputSpec
    Shikigami.BehaviorProviderSpec
    Shikigami.DelegateContextSpec
    Shikigami.Fixture.KawaStub
    Shikigami.FlowLifecycleSpec
    Shikigami.GrantStoreSpec
    Shikigami.KeiroSpecificationSpec
    Shikigami.LogSpec
    Shikigami.PackageArchitectureSpec
    Shikigami.SinkHonestySpec
    Shikigami.SpikeWorkflowSpec
    Shikigami.WireCompatSpec

  hs-source-dirs: test
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , baikai
    , base
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , handan-core
    , hasql
    , hasql-pool
    , http-types
    , keiki
    , keiro
    , kioku-api
    , kioku-core
    , kiroku-store
    , pgmq-hasql
    , settei
    , settei-env
    , settei-optparse-applicative
    , settei-yaml
    , shibuya-core
    , shikigami-core
    , shikigami-migrations:test-support
    , tasty
    , tasty-hunit
    , text
    , time
    , vector
    , wai
    , warp
