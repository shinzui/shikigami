# flake.module.nix — project-specific flake-parts customizations.
#
# seihou does NOT manage this file: it is never regenerated or overwritten by
# `seihou run` or module migrations, so changes here survive template upgrades
# without conflict. See flake.module.nix.example for the full option reference.
#
# NOTE: Nix flakes only see git-tracked files, so this file must be `git add`ed
# for flake.nix's `builtins.pathExists ./flake.module.nix` import to pick it up.
{ inputs, lib, ... }:
{
  perSystem = { pkgs, config, ... }: {
    # librdkafka: the C library hw-kafka-client / kafka-effectful link against
    # (EP-3 --republish-topic and EP-4's activity.v1 stream consumer).
    # curl.dev supplies libcurl.pc, which PostgreSQL 18.6's libpq.pc now names
    # in Requires.private and postgresql-libpq checks during configuration.
    haskellProject.extraDevPackages = [ pkgs.curl.dev pkgs.hurl pkgs.rdkafka ];

    # Git metadata is unavailable after the flake source is copied into the Nix
    # store. Inject the same seven-character build identity that local Cabal
    # builds obtain from githash's Template Haskell splice.
    packages.default = lib.mkForce (
      pkgs.haskell.lib.overrideCabal
        (pkgs.haskell.packages."ghc9124".callCabal2nix "shikigami" inputs.self { })
        (old: {
          configureFlags = (old.configureFlags or [ ]) ++ [
            ''--ghc-option=-DGIT_HASH=\"${builtins.substring 0 7 (inputs.self.shortRev or "dirty")}\"''
          ];
        })
    );

    # keiro-dsl output is generated bytes, and a formatter editing it is an
    # edit. Excluding it keeps two properties that both matter:
    #
    #   * The firewall. `-- @generated by keiro-dsl` files are overwritten on
    #     every scaffold and are never hand-modified; fourmolu is a hand.
    #   * Determinism. Scaffolding an unchanged specification twice must report
    #     every generated module `unchanged`. Formatting them makes the next
    #     scaffold report `overwritten` instead, and the committed bytes then
    #     alternate between generator output and formatter output forever.
    #
    # Only the generated paths are excluded. The create-once, hand-owned
    # KeiroConformance.Expectations module inside the conformance package is
    # deliberately NOT excluded: it is application code and is formatted like
    # any other.
    treefmt.settings.global.excludes = [
      "shikigami-core/src/Shikigami/Generated/*.hs"
      "shikigami-core/src/Shikigami/Generated/Nominals/*.hs"
      "shikigami-core/src/.keiro-dsl-generated-haskell-migrations/**"
      "shikigami-core/src/Shikigami/*/Generated/*.hs"
      "shikigami-core/src/keiro-dsl-conformance.workspace.*/*.cabal"
      "shikigami-core/src/keiro-dsl-conformance.workspace.*/src/Main.hs"
    ];
  };
}
