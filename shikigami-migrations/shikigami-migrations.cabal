cabal-version:      3.0
name:               shikigami-migrations
version:            0.1.0.0
synopsis:
  Schema migrations for shikigami (composes kioku + shikigami_fired)

build-type:         Simple
extra-source-files: sql-migrations/*.sql

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import:          common
  hs-source-dirs:  src
  exposed-modules: Shikigami.Migrations
  build-depends:
    , base              >=4.18   && <5
    , bytestring        >=0.11   && <0.13
    , codd              >=0.1.8  && <0.2
    , file-embed        >=0.0.15 && <0.0.17
    , kioku-migrations
    , streaming         >=0.2    && <0.3
    , text              >=2.0    && <2.2
    , time              >=1.12   && <1.15

executable shikigami-migrate
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , codd
    , shikigami-migrations
    , time                  >=1.12 && <1.15

library test-support
  import:          common
  visibility:      public
  hs-source-dirs:  test-support
  exposed-modules: Shikigami.Migrations.TestSupport
  build-depends:
    , aeson                 >=2.1   && <2.3
    , attoparsec
    , base                  >=4.18  && <5
    , codd                  >=0.1.8 && <0.2
    , containers            >=0.6   && <0.8
    , ephemeral-pg          >=0.2   && <0.3
    , shikigami-migrations
    , text                  >=2.0   && <2.2
    , time                  >=1.12  && <1.15
