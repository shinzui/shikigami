cabal-version:      3.0
name:               shikigami-migrations
version:            0.1.0.0
synopsis:
  Schema migrations for shikigami (composes kioku + shikigami_fired)

build-type:         Simple
extra-source-files:
  sql-migrations/*.sql
  sql-migrations/manifest

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import:          common
  hs-source-dirs:  src
  exposed-modules: Shikigami.Migrations
  build-depends:
    , base                     >=4.18     && <5
    , bytestring               >=0.11     && <0.13
    , containers               >=0.6      && <0.8
    , keiro-migrations         ^>=0.4.0.1
    , kioku-core               ^>=0.2.0.0
    , kioku-migrations         ^>=0.2.0.0
    , kiroku-store             ^>=0.3.1.0
    , kiroku-store-migrations  ^>=0.3.0.0
    , pg-migrate               ^>=1.1.0.0
    , pg-migrate-embed         ^>=1.1.0.0
    , text                     >=2.0      && <2.2

executable shikigami-migrate
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson                 >=2.2      && <2.3
    , base
    , bytestring
    , hasql                 >=1.10     && <1.11
    , optparse-applicative  >=0.19     && <0.20
    , pg-migrate            ^>=1.1.0.0
    , pg-migrate-cli        ^>=1.1.0.0
    , shikigami-migrations
    , text                  >=2.1      && <2.2

test-suite shikigami-migrations-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , shikigami-migrations
    , tasty
    , tasty-hunit

library test-support
  import:          common
  visibility:      public
  hs-source-dirs:  test-support
  exposed-modules: Shikigami.Migrations.TestSupport
  build-depends:
    , base                     >=4.18     && <5
    , hasql                    >=1.10     && <1.11
    , pg-migrate-test-support  ^>=1.1.0.0
    , shikigami-migrations
    , text                     >=2.0      && <2.2
