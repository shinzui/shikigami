cabal-version: 3.0
name:          shikigami-server
version:       0.1.0.0
synopsis:      Shikigami HTTP server and administrative commands
build-type:    Simple

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Shikigami.Health.Handler
    Shikigami.Server.App
    Shikigami.Server.Boot
    Shikigami.Server.Command
    Shikigami.Server.Command.Agents
    Shikigami.Server.Command.DanwaSpike
    Shikigami.Server.Command.EnqueueRun
    Shikigami.Server.Command.Grants
    Shikigami.Server.Command.Ops
    Shikigami.Server.Command.PublishFixture
    Shikigami.Server.Command.RenderLifecycle
    Shikigami.Server.Command.Runs
    Shikigami.Server.Command.StubKanmon
    Shikigami.Server.Command.StubKawa
    Shikigami.Server.Command.Validate
    Shikigami.Server.Config
    Shikigami.Server.RequestLog
    Shikigami.Server.Seam
    Shikigami.Server.Telemetry
    Shikigami.Sink.KanmonStub
    Shikigami.Sink.KawaStub
    Shikigami.Sink.KawaStub.Republish
    Shikigami.Trigger.Publish

  build-depends:
    , aeson                                 >=2.2
    , base                                  >=4.21     && <5
    , bytestring
    , case-insensitive
    , containers                            >=0.6
    , danwa-api
    , danwa-client
    , effectful
    , filepath
    , hasql-pool
    , hs-opentelemetry-api
    , hs-opentelemetry-exporter-otlp
    , hs-opentelemetry-instrumentation-wai
    , hs-opentelemetry-propagator-w3c
    , hs-opentelemetry-sdk
    , http-types
    , hw-kafka-client
    , kafka-effectful
    , keiro                                 ==0.14.0.0
    , keiro-ops                             ==0.14.0.0
    , kioku-api
    , kioku-core
    , kiroku-store
    , mmzk-typeid
    , mtl
    , optparse-applicative                  >=0.18
    , servant                               >=0.20     && <0.21
    , servant-health                        >=0.1      && <0.2
    , servant-server                        >=0.20     && <0.21
    , settei                                ==0.2.0.0
    , settei-optparse-applicative           ==0.2.0.0
    , shikigami-api
    , shikigami-core
    , text                                  >=2.1
    , time                                  >=1.12
    , unix
    , uuid                                  >=1.3      && <1.4
    , wai
    , warp

executable shikigami-server
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/server
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , shikigami-server

executable shikigami
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/admin
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , optparse-applicative
    , shikigami-server

test-suite shikigami-server-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  other-modules:
    Shikigami.Server.AgentsSpec
    Shikigami.Server.CommandSpec
    Shikigami.Server.DispatchSpec
    Shikigami.Server.KanmonStubSpec
    Shikigami.Server.KawaStubSpec
    Shikigami.Server.ProblemSpec
    Shikigami.Server.RequestLogSpec
    Shikigami.Server.TelemetrySpec

  -- The probe conformance kit and the WAI round-trip tests run a real Warp
  -- server; Warp's timer manager requires the threaded runtime.
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , hs-opentelemetry-api
    , hs-opentelemetry-exporter-in-memory
    , hs-opentelemetry-instrumentation-wai
    , hs-opentelemetry-propagator-w3c
    , hs-opentelemetry-sdk
    , http-client
    , http-types
    , lens
    , openapi-hs
    , optparse-applicative
    , servant
    , servant-health
    , servant-health:testkit
    , servant-server
    , settei
    , settei-env
    , shikigami-api
    , shikigami-core
    , shikigami-server
    , tasty
    , tasty-hunit
    , text
    , time
    , unordered-containers
    , vector
    , wai
    , warp
