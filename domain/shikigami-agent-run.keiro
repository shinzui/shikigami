# The durable agent-run workflow: one fired trigger becomes one agent run.
#
# The hand-owned runtime is Shikigami.Agent.Workflow in shikigami-core. This
# member owns the workflow's stable identity and the journal labels it writes,
# because those are the values a later change must not move silently.
#
# Not declared here, and why:
#
#   * The shikigami_run_jobs pgmq queue that feeds this workflow. Declaring it
#     as a `workqueue` would put Keiro's schema-version-1 {v,t,data} envelope on
#     a payload that Shikigami.Trigger.Enqueue sends bare, which is a codec
#     change disguised as a documentation change. See
#     docs/architecture/shikigami-domain-inventory.md.
#   * The per-approval awaits `approval:<SinkKind>:<ordinal>` and their
#     `:notify` steps, and the flow path's `emit-signal:<label>` steps. A
#     workflow label is a compile-time wire word ([A-Za-z0-9][A-Za-z0-9_-]*);
#     it can carry neither a colon nor a runtime-computed suffix. The
#     emit-signal labels are stable as of the patch declared below, but a
#     colon still keeps them out of this specification; the family's owner is
#     docs/plans/16-honest-sink-handlers-real-reiaction-and-honored-declaration-fields.md.
language keiro-dsl 5
context shikigami
layout collocated

workflow AgentRun
  name "shikigami.agent-run"
  # Shikigami.Agent.RunJob.RunJob. Only the fields this specification refers to
  # are inventoried; the rest of the record is hand-owned until a declared node
  # consumes it.
  in RunJob {
    agentName:Text
    idempotencyKey:Id
    occurredAt:Time
  }
  out AgentRunResult
  # WorkflowId is the job's idempotency key verbatim
  # (Shikigami.Agent.Workflow.runAgentRunWorkflow).
  id from input.idempotencyKey via idText
  body
    # The body is ordered for reading; replay matches journal records by label,
    # so this is the label inventory of every path through the workflow, not a
    # control-flow program. `run-behavior` and the flow path's `classify` /
    # `await-ack` are alternatives, and `fail-session` is exclusive with
    # `record` / `complete`.
    step ingest-job -> RunJob
    step lookup-agent -> AgentDecl
    # Instances already in flight when profile resolution ships must retain
    # their old body shape. Fresh instances resolve (or explicitly journal that
    # no profile is required) before opening a session.
    patch shikigami-resolve-profile-v1 {
      step resolve-profile -> ProfileResolution
    }
    step open-session -> SessionId
    step recall -> RecalledLearnings
    step run-behavior -> BehaviorOutput
    step classify -> RiskVerdict
    await await-ack -> ApprovalDecision
    # Shikigami.Flow.Capability.runSink decides once per interpreted flow run
    # whether a sink emission's journal label is the caller's stable token
    # (`emit-signal:alert`) or the old per-run ordinal (`emit-signal:0`). The
    # guard is required because switching schemes renames every emission at
    # once, which would orphan a parked flow's alert record and enqueue it a
    # second time. The block is empty because every label it guards carries a
    # colon and so cannot be declared; see docs/workflow-versioning.md.
    patch shikigami-emit-signal-labels-v1 {
    }
    step dispatch-sinks -> SinkResults
    step fail-session -> FailedSession
    step record -> RecordedLearning
    step complete -> CompletedSession
    # Shikigami.Agent.Delegate.delegate spawns a child of this same workflow;
    # the child id comes from the parent workflow id, the child agent name, and
    # a fresh per-run ordinal.
    child delegate id input via delegatedWorkflowId -> AgentRunResult

operation RunAgentRun
  run AgentRun
    input RunJob
    outcome -> AgentRunResult
