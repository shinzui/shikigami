language keiro-dsl 6
context shikigami
layout collocated

workflow AgentRun
  name "shikigami.agent-run"
  in RunJob
  out AgentRunResult
  id from input via runJobWorkflowId
  body
    step ingest-job -> RunJob
    patch shikigami-execution-resources-v1 {
      step validate-execution-root -> ResourceAdmission
    }
    step lookup-agent -> AgentDecl
    step resolve-profile -> ProfileResolution
    step resolve-capability-overlays -> CapabilityOverlayResolution
    patch shikigami-execution-selection-v1 {
      step resolve-execution-selection -> ExecutionSelectionResolution
    }
    step resolve-approval-policy -> ApprovalPolicySnapshot
    step open-session -> SessionId
    step recall -> RecalledLearnings
    patch shikigami-durable-execution-v1 {
      step admit-skill-execution -> ExecutionAdmissionResult
      child execution id input via executionWorkflowId -> ExecutionDriverResult
    }
    step run-behavior-v2 -> BehaviorOutput
    step classify -> RiskVerdict
    child approval id input via approvalWorkflowId -> ApprovalWorkflowResult
    patch shikigami-flow-decisions-v1 {
      step decision-policy -> DecisionPolicyResolution
      step decision-prepare-triage -> PreparedDecisionResolution
      step decision-result-triage -> DecisionOutcome
      step decision-catalog-investigate -> CandidateCatalog
      step decision-prepare-investigate -> PreparedDecisionResolution
      step decision-result-investigate -> DecisionOutcome
    }
    step route-catalog-architecture-practice -> CandidateCatalog
    patch shikigami-worker-coordination-v1 {
      step worker-coordination-policy -> CoordinationPolicyResolution
    }
    step route-decision-architecture-practice -> RouteDecision
    step recall-risk-history -> RecalledLearnings
    step remember-acknowledged -> RecordedLearning
    step remember-declined -> RecordedLearning
    step remember-escalated -> RecordedLearning
    step practice-review-remember-provisional -> PracticeReviewMemoryResult
    step practice-review-resolve -> PracticeReviewMemoryResult
    step practice-review-recall -> RecalledPracticeReviews
    step practice-review-chain -> PracticeReviewChain
    step practice-review-evidence -> EvidenceBundle
    step practice-review-evaluate -> PracticeReviewEvaluation
    step practice-review-attention -> AttentionReservationResult
    step dispatch-sinks -> SinkResults
    step fail-session -> FailedSession
    step record -> RecordedLearning
    step complete -> CompletedSession
    child delegate id input via delegatedWorkflowId -> AgentRunResult
operation RunAgentRun
  run AgentRun
    input RunJob
    outcome -> AgentRunResult
