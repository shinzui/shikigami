language keiro-dsl 6
context shikigami
layout collocated

workflow DeclaredToolStep
  name "shikigami.declared-tool-step"
  in DeclaredToolStepInput
  out ToolStepOutcome
  id from input via declaredToolStepWorkflowId
  body
    step ingest-declared-tool-step -> DeclaredToolStepInput
    step admit -> DeclaredToolAdmissionResult
    step attempt -> DeclaredToolAttemptResult
    step settle -> ToolStepOutcome
