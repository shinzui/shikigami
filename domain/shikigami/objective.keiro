language keiro-dsl 6
context shikigami
layout collocated

id ObjectiveId prefix=shikigami_objective

target objective_rows {
  schema = "shikigami"
  table = "objectives"
  reset = preserve
}
target objective_assignments {
  schema = "shikigami"
  table = "objective_assignments"
  reset = preserve
}
target objective_payloads {
  schema = "shikigami"
  table = "objective_payloads"
  reset = preserve
}
target objective_receipts {
  schema = "shikigami"
  table = "objective_receipts"
  reset = preserve
}
target objective_origins {
  schema = "shikigami"
  table = "objective_origins"
  reset = preserve
}
target objective_associations {
  schema = "shikigami"
  table = "objective_associations"
  reset = preserve
}
target objective_scopes {
  schema = "shikigami"
  table = "objective_scopes"
  reset = preserve
}
target objective_cursors {
  schema = "shikigami"
  table = "objective_cursors"
  reset = preserve
}
target objective_turn_admissions {
  schema = "shikigami"
  table = "objective_turn_admissions"
  reset = preserve
}
rebuild-group objective_store {
  targets = [ objective_rows objective_assignments objective_payloads objective_receipts objective_origins objective_associations objective_scopes objective_cursors ]
  order = [ objective_rows objective_assignments objective_payloads objective_receipts objective_origins objective_associations objective_scopes objective_cursors ]
}
projection-owner objective_writer {
  source = aggregate ObjectiveLifecycle
  delivery = inline
  group = objective_store
  targets = [ objective_rows objective_assignments objective_payloads objective_receipts objective_origins objective_associations objective_scopes objective_cursors ]
  order = 40
  replay = live-only "Objective commands require protected state, evidence and authority"
}
readmodel objective_lookup {
  columns {
    objective_id text required
    state jsonb required
    updated_at timestamptz required
  }
  version = 1
  shape = "fnv1a:39d57c7a554b1da9"
  freshness = immediate
  group = objective_store
  targets = [ objective_rows objective_assignments objective_payloads objective_receipts objective_origins objective_associations objective_scopes objective_cursors ]
  backing = objective_rows
}

rebuild-group objective_turn_store {
  targets = [ objective_turn_admissions ]
  order = [ objective_turn_admissions ]
}
projection-owner objective_turn_writer {
  source = aggregate ObjectiveTurnAdmission
  delivery = inline
  group = objective_turn_store
  targets = [ objective_turn_admissions ]
  order = 41
  replay = live-only "Turn admission requires protected memory and objective authority"
}
readmodel objective_turn_lookup {
  columns {
    run_id text required
    turn_id text required
    principal_key text required
    objective_id text
    admission jsonb required
  }
  version = 1
  shape = "fnv1a:18d729f1d572d494"
  freshness = immediate
  group = objective_turn_store
  targets = [ objective_turn_admissions ]
  backing = objective_turn_admissions
}

aggregate ObjectiveLifecycle
  regs
    objectiveId ObjectiveId = placeholder
    revision Int = 0
  states Missing Present
  command CreateObjective { objectiveId:ObjectiveId }
  command ApplyObjectiveTransition { objectiveId:ObjectiveId expected:Int revision:Int fingerprint:Text }
  command RecordTrackerTransition { objectiveId:ObjectiveId expected:Int fingerprint:Text }
  event ObjectiveCreated = fields(CreateObjective)
  event ObjectiveTransitionApplied = fields(ApplyObjectiveTransition)
  event TrackerTransitionRecorded = fields(RecordTrackerTransition)

  Missing -- CreateObjective -->
    write objectiveId := cmd.objectiveId
    emit ObjectiveCreated
    goto Present

  Present -- ApplyObjectiveTransition -->
    guard cmd.objectiveId == reg.objectiveId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ObjectiveTransitionApplied
    goto Present

  Present -- RecordTrackerTransition -->
    guard cmd.objectiveId == reg.objectiveId && cmd.expected == reg.revision
    emit TrackerTransitionRecorded
    goto Present

  wire kind=ctorName fields=camelCase schemaVersion=1


aggregate ObjectiveTurnAdmission
  regs
    source Text = ""
  states Missing Present
  command AdmitObjectiveTurn { source:Text }
  event ObjectiveTurnAdmitted = fields(AdmitObjectiveTurn)

  Missing -- AdmitObjectiveTurn -->
    write source := cmd.source
    emit ObjectiveTurnAdmitted
    goto Present

  wire kind=ctorName fields=camelCase schemaVersion=1
