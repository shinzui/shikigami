language keiro-dsl 6
context shikigami
layout collocated

mapped nominal ExecutionIdentity : Text {
  haskell package=shikigami-core module=Shikigami.Execution.Transcript type=ExecutionId
  binding = "Shikigami.Execution.Bindings.executionIdentityBinding"
  binding-version = "1"
  canonical-type = "shikigami.ExecutionId.v1"
  fixtures = "Shikigami.Execution.Bindings.executionIdentityCases"
  initial = "Shikigami.Execution.Bindings.initialExecutionIdentity"
}

target execution_rows {
  schema = "shikigami"
  table = "executions"
  reset = preserve
}
target execution_payloads {
  schema = "shikigami"
  table = "execution_payloads"
  reset = preserve
  depends-on = [ execution_rows ]
}
target execution_transcript_operations {
  schema = "shikigami"
  table = "execution_transcript_operations"
  reset = preserve
  depends-on = [ execution_rows execution_payloads ]
}
rebuild-group execution_store {
  targets = [ execution_rows execution_payloads execution_transcript_operations ]
  order = [ execution_rows execution_payloads execution_transcript_operations ]
}
projection-owner execution_writer {
  source = aggregate ExecutionLifecycle
  delivery = inline
  group = execution_store
  targets = [ execution_rows execution_payloads execution_transcript_operations ]
  order = 20
  replay = live-only "Execution snapshots and outcomes require protected application payloads"
}

readmodel execution_lookup {
  columns {
    execution_id text required
    state jsonb required
    binding jsonb required
    updated_at timestamptz required
  }
  version = 1
  shape = "fnv1a:4e813227de86c89d"
  freshness = immediate
  group = execution_store
  targets = [ execution_rows execution_payloads execution_transcript_operations ]
  backing = execution_rows
}

aggregate ExecutionLifecycle
  regs
    executionId ExecutionIdentity = initial
    snapshotDigest Text = ""
    revision Int = 0
    pendingReceipts Integer = 0
  states Missing Active Parked Unresolved SucceededPendingReceipts FailedPendingReceipts CancelledPendingReceipts Succeeded! Failed! Cancelled!

  command AdmitExecution { executionId:ExecutionIdentity snapshotDigest:Text }
  command AdvanceExecution { executionId:ExecutionIdentity expected:Int revision:Int }
  command ParkExecution { executionId:ExecutionIdentity expected:Int revision:Int }
  command ResumeExecution { executionId:ExecutionIdentity expected:Int revision:Int }
  command MarkExecutionUnresolved { executionId:ExecutionIdentity expected:Int revision:Int }
  command ReconcileExecution { executionId:ExecutionIdentity expected:Int revision:Int }
  command FinishExecution { executionId:ExecutionIdentity expected:Int revision:Int }
  command FailExecution { executionId:ExecutionIdentity expected:Int revision:Int }
  command CancelExecution { executionId:ExecutionIdentity expected:Int revision:Int }

  command RetryExecution { executionId:ExecutionIdentity expected:Int revision:Int }

  command SettleExecutionReceipt { executionId:ExecutionIdentity expected:Int revision:Int remaining:Integer }

  command FinishExecutionPendingReceipts { executionId:ExecutionIdentity expected:Int revision:Int }

  command FailExecutionPendingReceipts { executionId:ExecutionIdentity expected:Int revision:Int }

  command CancelExecutionPendingReceipts { executionId:ExecutionIdentity expected:Int revision:Int }

  event ExecutionAdmitted = fields(AdmitExecution)
  event ExecutionAdvanced = fields(AdvanceExecution)
  event ExecutionParked = fields(ParkExecution)
  event ExecutionResumed = fields(ResumeExecution)
  event ExecutionBecameUnresolved = fields(MarkExecutionUnresolved)
  event ExecutionReconciled = fields(ReconcileExecution)
  event ExecutionFinished = fields(FinishExecution)
  event ExecutionFailed = fields(FailExecution)
  event ExecutionCancelled = fields(CancelExecution)

  event ExecutionRetried = fields(RetryExecution)

  event ExecutionReceiptSettled = fields(SettleExecutionReceipt)
  event ExecutionReceiptsClosed = fields(SettleExecutionReceipt)

  event ExecutionFinishedPendingReceipts = fields(FinishExecutionPendingReceipts)

  event ExecutionFailedPendingReceipts = fields(FailExecutionPendingReceipts)

  event ExecutionCancelledPendingReceipts = fields(CancelExecutionPendingReceipts)

  Missing -- AdmitExecution -->
    write executionId := cmd.executionId
    write snapshotDigest := cmd.snapshotDigest
    emit ExecutionAdmitted
    goto Active

  Active -- AdvanceExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionAdvanced
    goto Active

  Active -- ParkExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionParked
    goto Parked

  Parked -- ResumeExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionResumed
    goto Active

  Active -- MarkExecutionUnresolved -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionBecameUnresolved
    goto Unresolved

  Unresolved -- MarkExecutionUnresolved -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionBecameUnresolved
    goto Unresolved

  Unresolved -- ReconcileExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionReconciled
    goto Active

  Active -- FinishExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionFinished
    goto Succeeded

  Active -- FailExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionFailed
    goto Failed

  Active -- CancelExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionCancelled
    goto Cancelled

  Parked -- FailExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionFailed
    goto Failed

  Parked -- CancelExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionCancelled
    goto Cancelled

  Unresolved -- FailExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionFailed
    goto Failed

  Unresolved -- CancelExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    emit ExecutionCancelled
    goto Cancelled

  Unresolved -- RetryExecution -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision
    write revision := cmd.revision
    write pendingReceipts := reg.pendingReceipts + 1
    emit ExecutionRetried
    goto Active

  Active -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptSettled
    goto Active

  Parked -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptSettled
    goto Parked

  Unresolved -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptSettled
    goto Unresolved

  Active -- FinishExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionFinishedPendingReceipts
    goto SucceededPendingReceipts

  SucceededPendingReceipts -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1 && cmd.remaining > 0
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptSettled
    goto SucceededPendingReceipts

  SucceededPendingReceipts -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1 && cmd.remaining == 0
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptsClosed
    goto Succeeded

  Active -- FailExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionFailedPendingReceipts
    goto FailedPendingReceipts

  Parked -- FailExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionFailedPendingReceipts
    goto FailedPendingReceipts

  Unresolved -- FailExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionFailedPendingReceipts
    goto FailedPendingReceipts

  FailedPendingReceipts -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1 && cmd.remaining > 0
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptSettled
    goto FailedPendingReceipts

  FailedPendingReceipts -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1 && cmd.remaining == 0
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptsClosed
    goto Failed

  Active -- CancelExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionCancelledPendingReceipts
    goto CancelledPendingReceipts

  Parked -- CancelExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionCancelledPendingReceipts
    goto CancelledPendingReceipts

  Unresolved -- CancelExecutionPendingReceipts -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0
    write revision := cmd.revision
    emit ExecutionCancelledPendingReceipts
    goto CancelledPendingReceipts

  CancelledPendingReceipts -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1 && cmd.remaining > 0
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptSettled
    goto CancelledPendingReceipts

  CancelledPendingReceipts -- SettleExecutionReceipt -->
    guard cmd.executionId == reg.executionId && cmd.expected == reg.revision && cmd.revision > reg.revision && reg.pendingReceipts > 0 && cmd.remaining == reg.pendingReceipts - 1 && cmd.remaining == 0
    write revision := cmd.revision
    write pendingReceipts := cmd.remaining
    emit ExecutionReceiptsClosed
    goto Cancelled

  wire kind=ctorName fields=camelCase schemaVersion=1
