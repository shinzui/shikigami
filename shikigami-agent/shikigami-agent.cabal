cabal-version: 3.0
name:          shikigami-agent
version:       0.1.0.0
synopsis:      One-off agent runs, without the platform
description:
  The command-line surface for running a declared Shikigami agent once, for
  consumers who are not operating the Kikan platform. It depends on
  shikigami-core and nothing else, so it links none of the messaging, queueing,
  or telemetry-export stack the deployed service needs. See
  docs/architecture/packages.md.

build-type:    Simple

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Shikigami.Agent.Command
    Shikigami.Agent.Command.AgentRun
    Shikigami.Agent.Command.RunBehavior

  build-depends:
    , aeson                 >=2.2
    , base                  >=4.21 && <5
    , kioku-api
    , kioku-core
    , kiroku-store
    , optparse-applicative  >=0.19 && <0.20
    , shikigami-core
    , text                  >=2.1
    , time

executable shikigami-run-behavior
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/run-behavior
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , shikigami-agent

executable shikigami-agent-run
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/agent-run
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , shikigami-agent

test-suite shikigami-agent-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  other-modules:  Shikigami.Agent.CommandSpec
  build-depends:
    , base
    , optparse-applicative
    , shikigami-agent
    , shikigami-core
    , tasty
    , tasty-hunit
    , text
