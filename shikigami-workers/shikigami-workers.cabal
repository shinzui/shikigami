cabal-version: 3.0
name: shikigami-workers
version: 0.1.0.0
synopsis: Shikigami supervised background loops
build-type: Simple
extra-source-files:
  cbits/workspace-deadline.c
  cbits/workspace-systemd-profile.h

common common
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall
    -Werror=missing-fields
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: common
  c-sources:
    cbits/workspace-collector.c
    cbits/workspace-files.c
    cbits/workspace-socket.c

  if os(linux)
    pkgconfig-depends: libsystemd
  hs-source-dirs: src
  exposed-modules:
    Shikigami.Agent.RunJob.Worker
    Shikigami.Agent.Workflow.Resume
    Shikigami.Flow.SinkOutbox.Publisher
    Shikigami.Health.Supervision
    Shikigami.Health.Worker
    Shikigami.Inspection.Consumer
    Shikigami.Integration.ConsumerRuntime
    Shikigami.Objective.Tracker.Worker
    Shikigami.Telemetry
    Shikigami.Telemetry.Sampler
    Shikigami.Trigger.Consumer
    Shikigami.Trigger.Scheduler
    Shikigami.Trigger.Timer
    Shikigami.Workers.Command
    Shikigami.Workers.Command.Scheduler
    Shikigami.Workers.Command.Worker
    Shikigami.Workers.Config
    Shikigami.Workers.Registry
    Shikigami.Workers.Shutdown
    Shikigami.Workers.Subscription
    Shikigami.Workspace.Allocation
    Shikigami.Workspace.Cleanup
    Shikigami.Workspace.Collector
    Shikigami.Workspace.ConfiguredHost
    Shikigami.Workspace.ContainedFile
    Shikigami.Workspace.Daemon
    Shikigami.Workspace.FileProvider
    Shikigami.Workspace.Git
    Shikigami.Workspace.GitCapture
    Shikigami.Workspace.GitObjects
    Shikigami.Workspace.GitProvider
    Shikigami.Workspace.Host
    Shikigami.Workspace.InstructionLoader
    Shikigami.Workspace.Integration
    Shikigami.Workspace.Maintenance
    Shikigami.Workspace.ProcessProvider
    Shikigami.Workspace.Profile
    Shikigami.Workspace.Provision
    Shikigami.Workspace.Rpc
    Shikigami.Workspace.Service
    Shikigami.Workspace.Supervisor
    Shikigami.Workspace.Systemd
    Shikigami.Workspace.Transfer

  build-depends:
    aeson >=2.2,
    async,
    baikai-trace-otel,
    base >=4.21 && <5,
    bytestring,
    containers >=0.6,
    directory,
    effectful,
    filepath,
    generic-lens,
    hasql,
    hasql-pool,
    hasql-transaction,
    hs-opentelemetry-api,
    hs-opentelemetry-exporter-otlp,
    hs-opentelemetry-sdk,
    http-client,
    http-client-tls,
    hw-kafka-client,
    kafka-effectful,
    keiro,
    keiro-ops-http,
    keiro-pgmq,
    kikan-en-client,
    kikan-en-contract,
    kioku-api,
    kioku-core,
    kiroku-metrics,
    kiroku-store,
    lens >=5.2,
    network,
    optparse-applicative >=0.19 && <0.20,
    pgmq-hasql,
    process,
    servant >=0.20 && <0.21,
    servant-client >=0.20 && <0.21,
    servant-health >=0.1 && <0.2,
    servant-server >=0.20 && <0.21,
    settei ==0.2.0.0,
    settei-optparse-applicative ==0.2.0.0,
    shibuya-core,
    shibuya-kafka-adapter,
    shibuya-metrics >=0.12.0.0 && <0.13,
    shikigami-core,
    shikigami-core:inspection,
    shikigami-migrations,
    shikumi-tools,
    text >=2.1,
    time >=1.12,
    unix,
    uuid,
    wai,
    warp,

executable shikigami-workspace-supervisor
  import: common
  main-is: Main.hs
  hs-source-dirs: app/workspace-supervisor
  ghc-options: -threaded
  build-depends:
    base,
    shikigami-workers,

executable shikigami-workspace-collector
  import: common
  main-is: Main.hs
  hs-source-dirs: app/workspace-collector
  ghc-options: -threaded
  build-depends:
    base,
    shikigami-workers,
    text,

executable shikigami-worker
  import: common
  main-is: Main.hs
  hs-source-dirs: app/worker
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    optparse-applicative,
    shikigami-workers,

executable shikigami-scheduler
  import: common
  main-is: Main.hs
  hs-source-dirs: app/scheduler
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    optparse-applicative,
    shikigami-workers,

executable shikigami-consume-stream
  import: common
  main-is: Main.hs
  hs-source-dirs: app/consume-stream
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    optparse-applicative,
    shikigami-workers,

executable shikigami-consume-events
  import: common
  main-is: Main.hs
  hs-source-dirs: app/consume-events
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    optparse-applicative,
    shikigami-workers,

test-suite shikigami-workers-test
  import: common
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Shikigami.AdmitProposalSpec
    Shikigami.Agent.RunJob.WorkerSpec
    Shikigami.AgentRun.StatusSpec
    Shikigami.ExecutionCapacitySpec
    Shikigami.Fixture.ExecutionIdentity
    Shikigami.Fixture.Proposing
    Shikigami.Health.SupervisionSpec
    Shikigami.Health.WorkerSpec
    Shikigami.InitiativeAcceptanceSpec
    Shikigami.Inspection.ConsumerSpec
    Shikigami.Integration.ConsumerRuntimeSpec
    Shikigami.ObjectiveTrackerWorkerSpec
    Shikigami.ProposeWorkSpec
    Shikigami.SchedulerSpec
    Shikigami.StreamInboxSpec
    Shikigami.TelemetrySpec
    Shikigami.TimerRecoverySpec
    Shikigami.Workers.CommandSpec
    Shikigami.WorkspaceContainedFileSpec
    Shikigami.WorkspaceFileProviderSpec
    Shikigami.WorkspaceGitObjectsSpec
    Shikigami.WorkspaceGitProviderSpec
    Shikigami.WorkspaceGitStoreSpec
    Shikigami.WorkspaceProcessProfileSpec
    Shikigami.WorkspaceProcessStoreSpec
    Shikigami.WorkspaceProvisionSpec
    Shikigami.WorkspaceRpcSpec
    Shikigami.WorkspaceStoreSpec
    Shikigami.WorkspaceSupervisorSpec
    Shikigami.WorkspaceSystemdSpec
    Shikigami.WorkspaceTransferSpec
    Shikigami.WorkspaceWorkflowSpec

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    aeson-pretty,
    async,
    baikai,
    base,
    bytestring,
    containers,
    directory,
    effectful,
    filepath,
    generic-lens,
    hasql,
    hasql-pool,
    hasql-transaction,
    hs-opentelemetry-exporter-in-memory,
    hs-opentelemetry-sdk,
    http-client,
    http-types,
    hw-kafka-client,
    keiro,
    keiro-pgmq,
    kioku-api,
    kioku-core,
    kiroku-metrics,
    kiroku-store,
    lens,
    network,
    optparse-applicative,
    pgmq-hasql,
    process,
    servant-health,
    servant-health:testkit,
    settei-env,
    shibuya-core,
    shikigami-core,
    shikigami-core:inspection,
    shikigami-migrations:test-support,
    shikigami-workers,
    shikumi-tools,
    tasty,
    tasty-hunit,
    text,
    time,
    unix,
    uuid,
    vector,
    wai,
    websockets,
