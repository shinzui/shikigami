cabal-version: 3.0
name:          shikigami-workers
version:       0.1.0.0
synopsis:      Shikigami supervised background loops
build-type:    Simple

common common
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          common
  hs-source-dirs:  src
  exposed-modules:
    Shikigami.Agent.RunJob.Worker
    Shikigami.Agent.Workflow.Resume
    Shikigami.Flow.SinkOutbox.Publisher
    Shikigami.Telemetry
    Shikigami.Trigger.Consumer
    Shikigami.Trigger.Scheduler
    Shikigami.Trigger.Timer
    Shikigami.Workers.Command
    Shikigami.Workers.Command.Scheduler
    Shikigami.Workers.Command.Worker
    Shikigami.Workers.Config
    Shikigami.Workers.Registry
    Shikigami.Workers.Subscription

  build-depends:
    , aeson                           >=2.2
    , async
    , baikai-trace-otel
    , base                            >=4.21    && <5
    , bytestring
    , containers                      >=0.6
    , directory
    , effectful
    , filepath
    , generic-lens
    , hasql
    , hasql-pool
    , hasql-transaction
    , hs-opentelemetry-api
    , hs-opentelemetry-exporter-otlp
    , hs-opentelemetry-sdk
    , hw-kafka-client
    , kafka-effectful
    , keiro
    , keiro-pgmq
    , kioku-api
    , kioku-core
    , kiroku-store
    , optparse-applicative            >=0.19    && <0.20
    , pgmq-hasql
    , settei                          ==0.2.0.0
    , settei-optparse-applicative     ==0.2.0.0
    , shibuya-core
    , shibuya-kafka-adapter
    , shikigami-core
    , text                            >=2.1
    , time                            >=1.12
    , uuid

executable shikigami-worker
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/worker
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , optparse-applicative
    , shikigami-workers

executable shikigami-scheduler
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/scheduler
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , optparse-applicative
    , shikigami-workers

executable shikigami-consume-stream
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/consume-stream
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , optparse-applicative
    , shikigami-workers

executable shikigami-consume-events
  import:         common
  main-is:        Main.hs
  hs-source-dirs: app/consume-events
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , optparse-applicative
    , shikigami-workers

test-suite shikigami-workers-test
  import:         common
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  other-modules:
    Shikigami.Agent.RunJob.WorkerSpec
    Shikigami.SchedulerSpec
    Shikigami.StreamInboxSpec
    Shikigami.Workers.CommandSpec

  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , effectful
    , hasql-pool
    , keiro
    , keiro-pgmq
    , kioku-api
    , kioku-core
    , kiroku-store
    , optparse-applicative
    , pgmq-hasql
    , settei-env
    , shibuya-core
    , shikigami-core
    , shikigami-migrations:test-support
    , shikigami-workers
    , tasty
    , tasty-hunit
    , text
    , time
    , vector
